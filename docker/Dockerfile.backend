# ============================================================
# backend (NestJS) ローカル実行用イメージ
# ------------------------------------------------------------
# ビルドコンテキスト = backend/（docker-compose.yml が指定）
# 通常の HTTP サーバー（main.ts）として起動する。
# ============================================================
FROM node:22-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist

EXPOSE 3000
CMD ["node", "dist/main.js"]
