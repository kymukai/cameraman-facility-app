# docker/.env.prod にコピーして値を設定してください（.env.prod はgit管理対象外）
#
# 使い方（docker/ ディレクトリで実行）:
#   cp .env.prod.example .env.prod
#   ./certs/generate-cert.sh <公開先IPアドレス>
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# フロントエンドの公開URL（このオリジンからのAPIアクセスのみ許可する）
CORS_ORIGIN=https://<公開先IPアドレス>

# Postgres認証情報（ローカル開発用の app/app は使わないこと）
POSTGRES_USER=app
POSTGRES_PASSWORD=<強固なパスワードに変更してください>
POSTGRES_DB=app
